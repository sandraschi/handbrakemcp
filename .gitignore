# HandBrake (encode outputs: *.log everywhere, *.json as stray CLI output.
# Source JSON must stay tracked — un-ignore it explicitly. Without these
# negations a fresh clone is missing package.json/tsconfigs/manifests.)
*.log
*.json
!package.json
!**/package.json
!tsconfig*.json
!**/tsconfig*.json
!biome.json
!**/biome.json
!manifest.json
!glama.json
!mcpb/manifest.json
!hooks/hooks.json
!.claude-plugin/plugin.json
!.agents/skills/config.json

# Node / webapp
node_modules/
**/node_modules/

# MCPB bundles (built artifacts)
*.mcpb

# Assess/audit working snapshots (regenerable, not source)
reports/

# Temp files
*.tmp
*.bak
*.bak.*
*.swp
*~

# Project specific
/processed/
/output/
# Rust / Zed IDE — rust-analyzer may create target/ at repo root
target/

_dashboard/

# MCPB build artifact -- staging copy of src/, regenerated by mcpb/pack.ps1
# on every pack. Never hand-edit, never commit.
mcpb/src/
